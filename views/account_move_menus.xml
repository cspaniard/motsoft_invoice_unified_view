<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Clientes: facturas + rectificativas de cliente
         ============================================================ -->
    <record id="action_all_customer_invoices" model="ir.actions.act_window">
        <field name="name">Todas las Facturas de Clientes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund'])]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'group_by': ['journal_id', 'invoice_date:year']}</field>
        <field name="limit">1000</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una factura de cliente
            </p>
            <p>
                Aquí se muestran tanto las facturas como las facturas rectificativas de clientes.
            </p>
        </field>
    </record>

    <menuitem id="menu_all_customer_invoices"
              name="Todas las Facturas"
              parent="account.menu_finance_receivables"
              action="action_all_customer_invoices"
              sequence="10"
              groups="account.group_account_invoice,account.group_account_readonly"/>

    <!-- ============================================================
         Proveedores: facturas + rectificativas de proveedor
         ============================================================ -->
    <record id="action_all_vendor_bills" model="ir.actions.act_window">
        <field name="name">Todas las Facturas de Proveedores</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'group_by': ['journal_id', 'invoice_date:year']}</field>
        <field name="limit">1000</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrar una factura de proveedor
            </p>
            <p>
                Aquí se muestran tanto las facturas como las facturas rectificativas de proveedores.
            </p>
        </field>
    </record>

    <menuitem id="menu_all_vendor_bills"
              name="Todas las Facturas"
              parent="account.menu_finance_payables"
              action="action_all_vendor_bills"
              sequence="10"
              groups="account.group_account_invoice,account.group_account_readonly"/>

</odoo>
